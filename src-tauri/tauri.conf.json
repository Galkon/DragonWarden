{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DragonWarden",
  "version": "0.1.1",
  "identifier": "com.dragonwarden.app",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "DragonWarden", "width": 1180, "height": 820, "minWidth": 940, "minHeight": 680, "resizable": true, "theme": "Dark", "backgroundColor": "#0b1115" }], "security": { "csp": "default-src 'self'; connect-src 'self' https://api.ipify.org; style-src 'self' 'unsafe-inline'; img-src 'self' asset:;" } },
  "bundle": { "active": true, "targets": "nsis", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"], "windows": { "nsis": { "displayLanguageSelector": false } } }
}
